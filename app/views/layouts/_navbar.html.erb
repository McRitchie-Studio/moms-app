<%# Public family-site navbar (overrides the engine base): brand + section links
    + theme toggle. Browsing needs no sign-in; only digesting a book is admin-only. %>
<%
  words = Studio.app_name.split
  last_word = words.pop
  prefix = words.join(" ")
  logo_path = Studio.logo_for("Navbar Logo")
  # The brand is the page's h1 only on the home dashboard, which has no title
  # of its own. Every other page carries its h1 in its page header.
  brand_tag = current_page?(root_path) ? :h1 : :span
%>
<header data-controller="scroll-shadow" data-action="scroll@window->scroll-shadow#update"
        data-scroll-shadow-scrolled-class="shadow-lg border-b border-subtle"
        class="sticky top-0 z-50 bg-page transition-shadow duration-300">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 px-4 py-3">
    <%= link_to root_path, class: "inline-flex items-center gap-3 group" do %>
      <% if logo_path %>
        <img src="<%= logo_path %>" alt="<%= Studio.app_name %>"
             class="w-10 h-10 rounded-full shadow group-hover:scale-105 transition">
      <% end %>
      <%= content_tag brand_tag, class: "text-2xl font-extrabold text-heading tracking-tight" do %>
        <%= prefix %> <span class="text-primary"><%= last_word %></span>
      <% end %>
    <% end %>

    <nav class="flex items-center gap-5">
      <%= link_to "Photos", slideshow_path, class: "text-body hover:text-primary text-sm font-semibold transition" %>
      <%= link_to "Library", books_path, class: "text-body hover:text-primary text-sm font-semibold transition" %>
      <%= render "components/theme_toggle_morph" %>
    </nav>
  </div>
</header>
