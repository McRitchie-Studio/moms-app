<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Moms App" %></title>
    <%= render "layouts/studio/head" %>
  </head>

  <body x-data class="bg-page text-body min-h-screen" :class="{ 'dev-mode': $store.devMode }">
    <%# Self-gating (studio-engine >= 0.30): the partial decides whether to
        appear, what to say, and whether the Local Inbox is linkable. No
        conditional here — replaces the hand-rolled strip this app copied from
        the engine's old NEW_APP_SETUP.md § 9. %>
    <%= render "studio/banners/environment" %>

    <%= render "layouts/navbar" %>

    <div class="max-w-7xl mx-auto px-4 py-6">
      <%= render "layouts/studio/flash" %>
      <%= yield %>
    </div>
  </body>
</html>
