<%# Karen's family photo carousel — shared by /slideshow and the root dashboard.
    Autoplay 3s, responsive 3/2/1-up, pause on hover / button. %>
<div data-controller="carousel" data-action="mouseenter->carousel#stop mouseleave->carousel#start">
  <div data-carousel-target="track"
       class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2"
       style="scrollbar-width: none;">
    <% (1..SlideshowController::PHOTO_COUNT).each do |i| %>
      <div class="snap-start shrink-0 w-full sm:w-1/2 lg:w-1/3">
        <div class="card p-0 overflow-hidden">
          <%= image_tag "karen/karen#{i}.jpg", alt: "Karen — photo #{i}", loading: "lazy",
                class: "w-full h-72 object-cover" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-center gap-3 mt-4">
    <button type="button" data-action="carousel#prev" class="btn btn-secondary btn-sm" aria-label="Previous photo">‹ Prev</button>
    <button type="button" data-action="carousel#toggle" data-carousel-target="toggle" class="btn btn-outline btn-sm">Pause</button>
    <button type="button" data-action="carousel#next" class="btn btn-secondary btn-sm" aria-label="Next photo">Next ›</button>
  </div>
</div>
