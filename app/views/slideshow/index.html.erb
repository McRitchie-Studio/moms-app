<% content_for :title, "Mom's Photos" %>

<div class="mb-6">
  <h1 class="text-3xl font-extrabold text-heading">Mom's <span class="text-primary">Photos</span></h1>
  <p class="text-secondary">A little slideshow for Karen — consolidated from the old karenmcritchie.com.</p>
</div>

<div x-data="karenSlideshow()" x-init="start()" @mouseenter="stop()" @mouseleave="start()">
  <div x-ref="track"
       class="flex gap-4 overflow-x-auto snap-x snap-mandatory scroll-smooth pb-2"
       style="scrollbar-width: none;">
    <% @photos.each_with_index do |photo, idx| %>
      <div class="snap-start shrink-0 w-full sm:w-1/2 lg:w-1/3">
        <div class="card p-0 overflow-hidden">
          <%= image_tag photo, alt: "Karen — photo #{idx + 1}", loading: "lazy",
                class: "w-full h-72 object-cover" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="flex items-center justify-center gap-3 mt-4">
    <button type="button" @click="prev()" class="btn btn-secondary btn-sm" aria-label="Previous photo">‹ Prev</button>
    <button type="button" @click="toggle()" class="btn btn-outline btn-sm" x-text="playing ? 'Pause' : 'Play'">Pause</button>
    <button type="button" @click="next()" class="btn btn-secondary btn-sm" aria-label="Next photo">Next ›</button>
  </div>
</div>

<%# Defined as a global factory (not via alpine:init) so it survives Turbo
    navigation — x-data re-evaluates it on every init, initial load or Turbo. %>
<script>
  window.karenSlideshow = () => ({
    playing: false,
    timer: null,
    start() {
      this.stop();
      this.timer = setInterval(() => this.next(), 3000);
      this.playing = true;
    },
    stop() {
      if (this.timer) clearInterval(this.timer);
      this.timer = null;
      this.playing = false;
    },
    toggle() { this.timer ? this.stop() : this.start(); },
    stepWidth() {
      const card = this.$refs.track.querySelector('.snap-start');
      return card ? card.offsetWidth + 16 : this.$refs.track.clientWidth;
    },
    next() {
      const t = this.$refs.track;
      if (Math.ceil(t.scrollLeft + t.clientWidth) >= t.scrollWidth - 2) {
        t.scrollTo({ left: 0, behavior: 'smooth' });
      } else {
        t.scrollBy({ left: this.stepWidth(), behavior: 'smooth' });
      }
    },
    prev() {
      const t = this.$refs.track;
      if (t.scrollLeft <= 2) {
        t.scrollTo({ left: t.scrollWidth, behavior: 'smooth' });
      } else {
        t.scrollBy({ left: -this.stepWidth(), behavior: 'smooth' });
      }
    },
  });
</script>
