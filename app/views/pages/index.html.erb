<% content_for :title, "Moms App" %>

<%# Slideshow first %>
<section class="mb-12">
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-2xl font-extrabold text-heading">Mom's <span class="text-primary">Photos</span></h2>
    <%= link_to "Open slideshow →", slideshow_path, class: "text-muted hover:text-primary text-sm" %>
  </div>
  <%= render "slideshow/carousel" %>
</section>

<%# Library second %>
<section>
  <div class="flex items-center justify-between mb-4">
    <h2 class="text-2xl font-extrabold text-heading">The <span class="text-primary">Library</span></h2>
    <%= link_to "Digest a book", new_book_path, class: "btn btn-primary btn-sm" %>
  </div>
  <%= render "books/grid", books: @books %>
</section>
