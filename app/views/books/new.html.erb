<% content_for :title, "Digest a book" %>

<%# The engine page header (studio/_page_header) under Home › Library, which
    replaces the old "← Library" link. It is a direct child of the layout's
    <main>, outside the narrow form column, so it stays pinned on scroll. %>
<%= render "studio/page_header", title: "Digest a book", crumbs: studio_crumbs(parent: :library) %>

<div class="max-w-xl mx-auto mt-6">
  <p class="text-secondary mb-6">
    Paste a LibriVox / Internet Archive identifier. We'll pull the cover and
    metadata, then stitch the first chapters into one playable file.
  </p>

  <%= form_with url: books_path, method: :post do |f| %>
    <label class="label-upper">Internet Archive identifier</label>
    <%= f.text_field :identifier, value: "adventures_sherlockholmes_1007_librivox", class: "input-field w-full mb-4" %>

    <label class="label-upper">Chapters to stitch <span class="text-muted lowercase">(blank = whole book)</span></label>
    <%= f.number_field :chapter_limit, value: "", min: 1, placeholder: "whole book", class: "input-field w-full mb-6" %>

    <div class="flex gap-3">
      <%= f.submit "Digest book", class: "btn btn-primary" %>
      <%= link_to "Cancel", books_path, class: "btn btn-outline" %>
    </div>
  <% end %>

  <p class="text-muted text-xs mt-4">
    Example: <code>adventures_sherlockholmes_1007_librivox</code> —
    <em>The Adventures of Sherlock Holmes</em> (public domain).
  </p>
</div>
